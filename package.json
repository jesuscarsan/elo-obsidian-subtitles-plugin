{
    "name": "elo-obsidian-subtitles-plugin",
    "version": "1.0.0",
    "description": "Subtitles integration for Elocuency.",
    "main": "dist/main.js",
    "scripts": {
        "build": "npm run typecheck && node scripts/esbuild.config.mjs",
        "dev": "node ../../libs/obsidian-plugin/scripts/bump-version.js && node scripts/esbuild.config.mjs --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "format": "prettier --write .",
        "test": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "subtitles"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@elo/obsidian-plugin": "workspace:*",
        "@types/node": "^20.11.19",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "esbuild": "^0.20.2",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "obsidian": "^1.12.0",
        "prettier": "^3.2.5",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "@elo/core": "workspace:*"
    }
}